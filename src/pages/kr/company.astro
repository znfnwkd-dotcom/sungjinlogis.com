---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '회사소개 | 성진로지스';
const description =
  '성진로지스는 자동차 내장 및 모바일 부품을 위한 플라스틱 도금·표면처리 전문 기업입니다. 로봇 전처리, 공정 안정화, 사내 검증으로 재현성과 컬러 일치성을 구현합니다.';

const companyImages = {
  map: {
    src: '/images/about/location-map.png',
    alt: '성진로지스 위치(인천) 안내 지도',
  },
};

const heroVideo = {
  src: '/media/media1.mp4',
  caption: 'Robot Demo · 로봇 전처리 시연',
};

const secondaryVideo = {
  src: '/media/media2.mp4',
  caption: 'Robot Demo 2 · 추가 시연 영상',
};

const companyInfo = [
  { label: '법인명', value: '㈜성진로지스' },
  { label: '주소', value: '인천광역시 서구 중봉대로240번길 24' },
  { label: '대표', value: '지원석' },
  { label: '임직원', value: '60명' },
  { label: 'Tel', value: '+82-32-573-4789' },
  { label: 'Fax', value: '+82-32-573-4790' },
  { label: 'Email', value: 'contact@sungjinlogis.com', href: 'mailto:contact@sungjinlogis.com' },
];

const mapLink =
  'https://www.google.com/maps/search/?api=1&query=%EC%9D%B8%EC%B2%9C%EA%B4%91%EC%97%AD%EC%8B%9C%20%EC%84%9C%EA%B5%AC%20%EC%A4%91%EB%B4%89%EB%8C%80%EB%A1%9C240%EB%B2%88%EA%B8%B8%2024';
---

<BaseLayout title={title} description={description} lang="ko" pathPrefix="/kr">
  <section class="rounded-2xl border border-stroke bg-surface p-8 shadow-soft">
    <div class="max-w-5xl">
      <a class="text-sm text-accent hover:underline" href="/kr/">
        ← Home
      </a>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        플라스틱 도금·표면처리 전문
      </h1>

      <p class="mt-3 text-sm md:text-base leading-relaxed !text-sub drop-shadow-md">
        성진로지스는 <span class="text-white font-semibold">재현성</span>을 기준으로 공정을 설계하고,
        <span class="text-white font-semibold">컬러 일치성·표면 품질</span>을 안정적으로 구현합니다.<br />
        자동차 내장 및 모바일 부품용 <span class="text-white font-semibold">프리미엄 외관 부품</span> 도금/표면처리를 제공합니다.
      </p>

      {/* ✅ 카드 위쪽: 대표 로봇 시연 영상(회사소개 진입 시) */}
      <div class="mt-5 overflow-hidden rounded-2xl border border-stroke bg-base shadow-soft">
        <div class="relative bg-black/10" style="aspect-ratio: 2 / 1;">
          <video
            class="absolute inset-0 h-full w-full object-cover"
            src={heroVideo.src}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            data-autoplay
          ></video>

          {/* 하단 그라데이션 + 캡션 */}
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 via-black/25 to-transparent">
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <div class="text-xs text-white/85">
                {heroVideo.caption}
              </div>

              {/* (선택) 아래 추가 영상으로 자연스럽게 유도 */}
              <a class="text-xs font-semibold text-white/85 hover:text-white underline-offset-4 hover:underline" href="#demo2">
                추가 시연 보기 ↓
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* 자동재생이 정책상 막히는 환경 대비: 실패 시 컨트롤 표시 */}
      <script is:inline>
        const v = document.querySelector('video[data-autoplay]');
        if (v) {
          const p = v.play();
          if (p && typeof p.catch === 'function') {
            p.catch(() => { v.controls = true; });
          }
        }
      </script>

      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-2xl border border-stroke bg-base p-5">
          <div class="text-sm font-semibold">재현성 기반 공정</div>
          <p class="mt-1 text-sm text-sub">조건 표준화와 변동 요인 통제로 동일 품질을 반복 구현</p>
        </div>
        <div class="rounded-2xl border border-stroke bg-base p-5">
          <div class="text-sm font-semibold">프리미엄 표면 품질</div>
          <p class="mt-1 text-sm text-sub">외관·촉감·색상 일치성을 목표로 한 품질 중심 운영</p>
        </div>
        <div class="rounded-2xl border border-stroke bg-base p-5">
          <div class="text-sm font-semibold">친환경 공정 대응</div>
          <p class="mt-1 text-sm text-sub">친환경 3가 크롬(Trivalent Chromium) 라인 운영</p>
        </div>
      </div>

      {/* ✅ 위치/시연 · 회사 정보 섹션 */}
      <div class="mt-10 grid gap-6 lg:grid-cols-5">
        {/* 왼쪽: 지도 + (전경사진 대신) 추가 시연 영상 */}
        <div class="lg:col-span-3 grid gap-4">
          <figure class="overflow-hidden rounded-2xl border border-stroke bg-base shadow-soft">
            <div class="flex items-center justify-center bg-black/10" style="aspect-ratio: 16 / 10;">
              <img
                src={companyImages.map.src}
                alt={companyImages.map.alt}
                class="h-full w-full object-contain"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="px-4 py-3 text-xs text-white/70">
              Location · Incheon, Korea
            </figcaption>
          </figure>

          <figure id="demo2" class="overflow-hidden rounded-2xl border border-stroke bg-base shadow-soft">
            <div class="flex items-center justify-center bg-black/10" style="aspect-ratio: 16 / 10;">
              <video
                class="h-full w-full object-cover"
                src={secondaryVideo.src}
                controls
                playsinline
                preload="metadata"
                controlsList="nodownload noremoteplayback"
                disablePictureInPicture
              ></video>
            </div>
            <figcaption class="px-4 py-3 text-xs text-white/70">
              {secondaryVideo.caption}
            </figcaption>
          </figure>
        </div>

        {/* 회사 정보 영역 */}
        <div class="lg:col-span-2 rounded-2xl border border-stroke bg-base p-6 shadow-soft">
          <h2 class="text-lg font-semibold">회사 정보</h2>
          <p class="mt-2 text-sm text-sub">
            상담/방문 시 필요한 기본 정보를 정리했습니다.
          </p>

          <dl class="mt-4 divide-y divide-stroke/60">
            {companyInfo.map((row) => (
              <div class="flex items-start justify-between gap-4 py-3">
                <dt class="text-sm text-white/70">{row.label}</dt>
                <dd class="text-sm text-white text-right">
                  {row.href ? (
                    <a class="text-accent hover:underline" href={row.href}>
                      {row.value}
                    </a>
                  ) : (
                    <span>{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>

          <div class="mt-5 flex flex-wrap gap-3">
            <a
              class="inline-flex items-center rounded-2xl border border-stroke bg-accent/15 px-4 py-2 text-sm font-semibold text-accent hover:bg-accent/20"
              href={mapLink}
              target="_blank"
              rel="noopener noreferrer"
            >
              지도에서 보기 →
            </a>
            <a
              class="inline-flex items-center rounded-2xl border border-stroke bg-white/5 px-4 py-2 text-sm font-semibold text-white hover:bg-white/10"
              href="/kr/contact/"
            >
              문의하기 →
            </a>
          </div>

          <p class="mt-3 text-xs text-white/60">
            * 주소: 인천광역시 서구 중봉대로240번길 24
          </p>
        </div>
      </div>

{/* 회사소개서 요약(3카드) */}
<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {/* 1) 핵심 역량 */}
  <div class="rounded-2xl border border-stroke bg-base p-6">
    <h2 class="text-lg font-semibold">핵심 역량</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-sub">
      <li><span class="text-white">산업용 로봇 전처리</span>로 균일한 기반 품질 확보</li>
      <li><span class="text-white">롱라이프 여과 기반 무광/반무광 공정</span>으로 공정 안정화</li>
      <li><span class="text-white">친환경 3가 크롬</span> 라인 운영(규제 대응)</li>
      <li><span class="text-white">유산동</span> 및 <span class="text-white">광택/반광 니켈</span> 캐리어 공정 운영</li>
    </ul>
  </div>

  {/* 2) 주요 적용 분야 (내용은 그대로, 2열 그리드로 가독성만 개선) */}
    <div class="rounded-2xl border border-stroke bg-base p-6">
    <h2 class="text-lg font-semibold">주요 적용 분야</h2>
    <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-sub">
      <li>자동차 내·외장 부품</li>
      <li>모바일·IT 정밀 부품</li>
      <li>전자·가전 외관 부품</li>
      <li>의료기기 외장·조작 부품</li>
      <li>산업·로봇·자동화 설비 부품</li>
      <li>프리미엄 생활·레저 부품</li>
      <li>스마트 보안 시스템 부품</li>
    </ul>
  </div>

  {/* 3) 품질·인증 (기존 박스를 “독립 카드”로 분리) */}
  <div class="rounded-2xl border border-stroke bg-base p-6">
    <h2 class="text-lg font-semibold">품질·인증</h2>

    <p class="mt-3 text-sm text-sub leading-relaxed">
      IATF 16949 / ISO 9001 / ISO 14001 인증 보유<br />
      현대·기아 SQ 인증 업체<br />
      GM Global Tier2 Supplier 등록<br />
      GM CQI-11 Plating System 요구사항 운영<br />
      APQP·PPAP 등 Core Tool 기반 품질 관리 체계 운영
    </p>
  </div>
</div>

      <div class="mt-10 rounded-2xl border border-stroke bg-base p-6">
        <h2 class="text-lg font-semibold">사내 검증(Verification) 설비</h2>
        <p class="mt-2 text-sm text-sub">
          공정 신뢰를 “측정 가능한 데이터”로 관리합니다.
        </p>
        <div class="mt-4 grid gap-3 md:grid-cols-2">
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">도금두께 측정기(Thickness Tester, 2 set)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">CASS 시험기 (CASS Tester)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">Hull Cell 시험기 (Hull Cell Tester)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">전자현미경 (Electron Microscope)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">온·습도 사이클 시험기 (Heat & Humidity Cycle Tester)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">XRF 두께 측정기 (XRF Thickness Tester)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">광학 현미경 (Optical Microscope)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">폴리싱(연마) 장비 (Polishing Machine)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">항온항습기 (Thermohygrostat)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">박리(밀착) 시험기 (Peel-off Tester)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">퀵 열충격 시험기 (Quick Thermal Tester)</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub">STEP 시험기 (STEP Tester)</div>
        </div>
      </div>

      <div class="mt-10 rounded-2xl border border-stroke bg-base p-6">
        <h2 class="text-lg font-semibold">연혁(History)</h2>
        <div class="mt-4 grid gap-3">
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">1995</span> · 지원산업 설립</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2005</span> · 모바일 부품용 친환경 3가 크롬 기술 도입</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2010</span> · 자동차(차량) 부품 도금 양산 시작</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2011</span> · ISO 9001 / ISO 14001 인증</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2014</span> · ㈜성진로지스 법인 전환</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2017</span> · SQ 인증</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2020</span> · IATF 16949 인증</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2021</span> · 로봇 자동 플라스틱 도금 라인(2공장) 구축</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2023</span> · 친환경 3가 크롬 도금 라인 구축</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2024</span> · 글로벌 프리미엄 OEM 친환경 3가 크롬 공급사 등록</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2025</span> · 화학니켈(무전해) 도금 라인(3공장) 구축</div>
          <div class="rounded-2xl border border-stroke bg-surface p-4 text-sm text-sub"><span class="text-white font-semibold">2026</span> · GM Tier2 3가 크롬 공급사 등록</div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a class="rounded-2xl bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-accent-hover transition"
           href="/kr/downloads/">
          회사소개서 다운로드
        </a>
        <a class="rounded-2xl border border-stroke bg-base px-5 py-3 text-sm font-semibold text-white hover:bg-surface transition"
           href="/kr/capabilities/">
          공정/역량 보기
        </a>
        <a class="text-sm text-accent hover:text-accent-hover"
           href="mailto:chiwon1@kakao.net">
          문의: chiwon1@kakao.net →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
